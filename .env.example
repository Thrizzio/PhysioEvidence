# ==============================================================================
# PhysioEvidence Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets or credentials to version control.
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ==============================================================================
# DEPLOYMENT / MANAGED (Neon PostgreSQL):
# Set DATABASE_URL to your managed PostgreSQL connection string with SSL mode.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/physioevidence?sslmode=require

# LOCAL DEVELOPMENT FALLBACK (Used only if DATABASE_URL is unset):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=physioevidence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ==============================================================================
# 2. EMBEDDINGS CONFIGURATION
# ==============================================================================
# Active provider: 'ollama' (default/local), 'local' (sentence-transformers), or 'gemini' (remote API)
EMBEDDING_PROVIDER=ollama

# Verified vector dimension: strictly 768 to match the PostgreSQL schema vector(768)
EMBEDDING_DIMENSIONS=768

# LOCAL OLLAMA EMBEDDINGS (Recommended default):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m

# LOCAL SENTENCE-TRANSFORMERS (Alternative local fallback):
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m

# REMOTE GEMINI EMBEDDINGS (Alternative remote API):
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ==============================================================================
# 3. LLM GENERATION & SYNTHESIS (Google Gemini)
# ==============================================================================
# Required for answer synthesis in RAG and Research API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# 4. DOCUMENT INGESTION SERVICE
# ==============================================================================
# Storage directory for uploaded original PDF documents:
INGESTION_STORAGE_ROOT=./data/originals

# Maximum upload file size in bytes (default: 50 MB = 52428800):
INGESTION_MAX_FILE_SIZE_BYTES=52428800

# Bearer token for authenticating admin ingestion API endpoints:
# For local dev: leave empty or set a development token.
# For deployment: set a cryptographically strong secret token.
INGESTION_ADMIN_TOKEN=replace_with_a_secure_token_for_deployment

# Optional maximum storage quota for original files in bytes (e.g., 1073741824 for 1 GB):
# INGESTION_QUOTA_BYTES=1073741824

# ==============================================================================
# 5. WEB UI & CORS ORIGINS
# ==============================================================================
# LOCAL DEVELOPMENT ORIGINS:
RESEARCH_UI_ORIGIN=http://localhost:8080
INGESTION_UI_ORIGIN=http://localhost:8081

# PRODUCTION / DEPLOYMENT ORIGINS (comma-separated):
# RESEARCH_UI_ORIGIN=https://research.yourdomain.com
# INGESTION_UI_ORIGIN=https://admin.yourdomain.com

# ==============================================================================
# 6. OBSERVABILITY & TRACING (LangSmith - Optional)
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=physioevidence
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
