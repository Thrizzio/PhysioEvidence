# ==========================================
# Gemini API Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ==========================================
# PostgreSQL & pgvector Configuration
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=physioevidence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
# Optional full connection URL (overrides individual variables if provided)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/physioevidence

# ==========================================
# Observability & Tracing (LangSmith - Optional)
# ==========================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=physioevidence
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
